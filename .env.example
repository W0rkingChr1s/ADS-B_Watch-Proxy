# Datenquelle: adsblol | airplaneslive | adsbone | adsbexchange
ADSB_PROVIDER=adsblol

# Nur fuer provider=adsbexchange (RapidAPI-Key)
ADSB_API_KEY=

# Shared Secret, das die Watch App im Header X-Api-Token mitschickt
ADSB_TOKEN=changeme

# Cache-Lebensdauer in Sekunden (schuetzt das 1-req/s-Limit der Upstreams)
ADSB_CACHE_TTL=8

# Minimaler Abstand zwischen zwei Upstream-Requests in Sekunden
ADSB_MIN_UPSTREAM_INTERVAL=1.0

# Harte Obergrenze fuer zurueckgegebene Ziele (Speicherlimit der Uhr!)
ADSB_MAX_TARGETS=20

# Timeout gegen den Upstream in Sekunden
ADSB_UPSTREAM_TIMEOUT=6.0

ADSB_LOG_LEVEL=INFO
